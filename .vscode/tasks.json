{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prepare build directory",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/.build"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build application",
            "type": "process",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/indexer.cpp",
                "${workspaceFolder}/file_manager.cpp",
                "${workspaceFolder}/cli.cpp",
                "-o",
                "${workspaceFolder}/.build/search_engine"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Prepare build directory",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build tests",
            "type": "process",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-I",
                "${workspaceFolder}",
                "${workspaceFolder}/tests/test.cpp",
                "${workspaceFolder}/indexer.cpp",
                "-o",
                "${workspaceFolder}/.build/run_tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}/tests"
            },
            "dependsOn": "Prepare build directory",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run tests",
            "type": "process",
            "command": "${workspaceFolder}/.build/run_tests",
            "dependsOn": "Build tests",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}/tests"
            },
            "problemMatcher": []
        }
    ]
}
